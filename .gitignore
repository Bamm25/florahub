# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Graphify output
/graphify-out
graphify-out/

# Backup files
*.backup
*.bak
app/globals.css.backup

# Documentation and reports (local development only)
/docs/
docs/
*.md
!README.md

# Local test data setup & ad-hoc scripts
setup-*.ts
prisma/seed-florist-*.ts
prisma/SEED-FLORIST-TEST-DATA.txt
prisma/check-*.ts
/scripts/
scripts/
/tests/
tests/

# IDE and tool states
.claude/
.windsurf/
.postman/

# Temporary debug files
COMMIT_MESSAGE.txt
*.sql
*.mjs
*test-coupon*.ts
debug-*.mjs
fix-*.mjs

# Uploaded files (but keep directory structure)
public/uploads/**
!public/uploads/**/.gitkeep
