# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/florahub"

# NextAuth & RFC 7519 JWT Signing
NEXTAUTH_SECRET="replace-with-strong-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_AUTHOR="FloraHub Team"
APP_TIMEZONE="Asia/Jakarta"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_API_TIMEOUT_MS="10000"

# Biteship Logistics
BITESHIP_API_KEY=""
BITESHIP_BASE_URL="https://api.biteship.com/v1"
BITESHIP_TIMEOUT_MS="30000"
BITESHIP_COURIERS="jne,jnt,sicepat,anteraja,ninja"
BITESHIP_WEBHOOK_SIGNATURE_KEY=""
BITESHIP_WEBHOOK_SIGNATURE_SECRET=""
ALLOW_FALLBACK_SHIPPING_RATE="true"
FALLBACK_SHIPPING_COST="15000"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://cdn.example.com"
UPLOAD_MAX_BYTES="5242880"

# Cron & Pre-Order Rules
CRON_SECRET=""
PREORDER_DEPOSIT_RATE="0.5"
PREORDER_DEPOSIT_DEADLINE_DAYS="3"
PREORDER_REMINDER_WINDOW_HOURS="24"

# Development-Only Shipment Simulator
ENABLE_BITESHIP_SIMULATOR="false"
NEXT_PUBLIC_ENABLE_BITESHIP_SIMULATOR="false"
